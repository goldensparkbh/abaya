# Copy to .env — use KEY=value (equals). Do not use colons after the key name.
# Values from Firebase Console → Project settings → Your apps → Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Payment API (Cloud Function / backend) for TAP Payment in production.
# Leave empty to use sandbox card simulation during development.
VITE_PAYMENT_API_URL=
